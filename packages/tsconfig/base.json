{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": [
    "Rules that hold for every app, whatever it runs on.",
    "Apps extend this and override only what their runtime genuinely forces —",
    "the same layering as @konstruct/eslint-config."
  ],
  "compilerOptions": {
    "target": "ES2023",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  }
}
