{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": [
    "Next.js apps. The bundler resolves modules and emits the output, so this",
    "only typechecks — hence noEmit, and DOM in lib."
  ],
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  }
}
