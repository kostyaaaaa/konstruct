{
  "name": "dota-bet-analytics",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Discovers live tier 1-2 Dota 2 pro matches, snapshots them, and serves the data to the console.",
  "license": "ISC",
  "scripts": {
    "dev": "infisical run --path=/dota-bet-analytics -- node --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start": "infisical run --path=/dota-bet-analytics -- node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axiomhq/js": "^2.0.0",
    "@konstruct/logger": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "mongoose": "^9.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@konstruct/eslint-config": "workspace:*",
    "@konstruct/tsconfig": "workspace:*",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "typescript": "^7.0.2"
  }
}
